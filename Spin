		local last = 0

		RunService.RenderStepped:Connect(function()
			if tick() - last < UPDATE_DELAY then return end
			last = tick()

			if (player == LocalPlayer and hideLocalPlayer) then
				clearInventoryDrawings(player)
				highlight.Adornee = nil; name.Visible = false; hp.Visible = false
				return
			end

			local char = player.Character
			if not char then
				highlight.Adornee = nil; name.Visible = false; hp.Visible = false
				clearInventoryDrawings(player)
				return
			end

			local head = char:FindFirstChild("Head")
			local root = char:FindFirstChild("HumanoidRootPart")
			local humanoid = char:FindFirstChildOfClass("Humanoid")

			if not head or not root or not humanoid then
				highlight.Adornee = nil; name.Visible = false; hp.Visible = false
				clearInventoryDrawings(player)
				return
			end

			if PlayerESP and humanoid.Health > 0 then
				highlight.Adornee = char
				local isTarget = (CurrentTarget == player)

				if isTarget then
					highlight.FillColor = THEME.StateOn; highlight.FillTransparency = 0.5
					highlight.OutlineColor = THEME.StateOn
					name.Color = THEME.StateOn
				elseif ExcludedPlayers[player.Name] then
					highlight.FillTransparency = 1
					highlight.OutlineColor = Color3.fromRGB(0, 255, 120)
					name.Color = Color3.fromRGB(0, 255, 120)
				else
					highlight.FillTransparency = 1
					highlight.OutlineColor = Color3.fromRGB(255, 220, 0)
					name.Color = Color3.new(1, 1, 1)
				end
			else
				highlight.Adornee = nil; name.Visible = false; hp.Visible = false
				clearInventoryDrawings(player)
				return
			end

			local headPos, headVis = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
			local rootPos, rootVis = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.3, 0))

			if not headVis or not rootVis or headPos.Z < 0 or rootPos.Z < 0 then
				name.Visible = false; hp.Visible = false
				clearInventoryDrawings(player)
				return
			end

			local height = math.abs(headPos.Y - rootPos.Y)
			local width = height / 2
			local x = rootPos.X - width / 2
			local y = headPos.Y
			local anchorX = x + width + 6
			local anchorY = y - 12

			if NameESP then
				name.Text = filtrarTexto(player.Name)
				name.Position = Vector2.new(anchorX, anchorY)
				name.Visible = true
			else 
				name.Visible = false 
			end

			if HealthESP then
				local percent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
				hp.Text = math.floor(humanoid.Health) .. " HP"
				hp.Color = Color3.fromRGB(255 * (1 - percent), 255 * percent, 50)
				hp.Position = Vector2.new(anchorX, anchorY + (NameESP and 14 or 0))
				hp.Visible = true
			else 
				hp.Visible = false 
			end

			-- ══════════════════════════════════════════════════════════════
			--  ESP DE ARMAS E INVENTARIO (AHORA USA EL SCRIPT ULTRA OPTIMIZADO)
			--  Mantiene exactamente la misma posición / altura / lugar del original
			-- ══════════════════════════════════════════════════════════════
			if WeaponESP then
				local infos = getPlayerTools(player)

				if not InventoryDrawings[player] then InventoryDrawings[player] = { drawings = {} } end
				local data = InventoryDrawings[player]

				while #data.drawings < #infos do
					local d = Drawing.new("Text")
					d.Size = 13 
					d.Center = false 
					d.Outline = true 
					d.Font = 2
					d.Visible = false
					table.insert(data.drawings, d)
				end

				for idx, d in ipairs(data.drawings) do
					if infos[idx] then
						local nombreArma = filtrarTexto(infos[idx].Name)
						-- Formato del script ultra optimizado
						d.Text = "[" .. nombreArma .. "]"
						d.Color = RarityColors[infos[idx].Rarity] or Color3.new(1, 1, 1)
						-- Posición y altura EXACTAMENTE igual que el original
						d.Position = Vector2.new(x + width / 2 - 20, y + height + 6 + ((idx - 1) * 14))
						d.Visible = true
					else
						d.Visible = false
					end
				end

				if #data.drawings > #infos then
					for i = #infos + 1, #data.drawings do
						data.drawings[i].Visible = false
					end
				end
			else
				clearInventoryDrawings(player)
			end
		end)
	end

