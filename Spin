--  SISTEMA DE PRIVACIDAD Y FILTRADO DE TEXTO
-- ══════════════════════════════════════════════════════════════

local function filtrarTexto(texto)
	if not texto or texto == "" then return "" end
	local resultado = string.gsub(texto, MyName, CAMBIAR_MI_NOMBRE_POR)
	resultado = string.gsub(resultado, MyDisplayName, CAMBIAR_MI_NOMBRE_POR)
	return resultado
end

local function procesarInstanciaTexto(instancia)
	if instancia:IsA("TextLabel") or instancia:IsA("TextButton") or instancia:IsA("TextBox") then
		if string.find(instancia.Text, MyName) or string.find(instancia.Text, MyDisplayName) then
			instancia.Text = filtrarTexto(instancia.Text)
		end
		instancia:GetPropertyChangedSignal("Text"):Connect(function()
			if string.find(instancia.Text, MyName) or string.find(instancia.Text, MyDisplayName) then
				instancia.Text = filtrarTexto(instancia.Text)
			end
		end)
	end
end

PlayerGui.DescendantAdded:Connect(procesarInstanciaTexto)
for _, v in ipairs(PlayerGui:GetDescendants()) do procesarInstanciaTexto(v) end

LocalPlayer.CharacterAdded:Connect(function(char)
	char.DescendantAdded:Connect(procesarInstanciaTexto)
	for _, v in ipairs(char:GetDescendants()) do procesarInstanciaTexto(v) end
end)

if LocalPlayer.Character then
	LocalPlayer.Character.DescendantAdded:Connect(procesarInstanciaTexto)
	for _, v in ipairs(LocalPlayer.Character:GetDescendants()) do procesarInstanciaTexto(v) end
end

